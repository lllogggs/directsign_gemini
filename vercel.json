{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/advertiser/login.ts": {
      "maxDuration": 10,
      "regions": [
        "icn1"
      ]
    },
    "api/influencer/login.ts": {
      "maxDuration": 10,
      "regions": [
        "icn1"
      ]
    },
    "api/index.ts": {
      "maxDuration": 30,
      "regions": [
        "icn1"
      ],
      "includeFiles": "public/fonts/**",
      "excludeFiles": "{data/**,**/runtime-secrets.json,**/*.log,docs/sales/**,qa-artifacts/**,tmp/**,.tmp/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ops-alerts",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.yeollock\\.me"
        }
      ],
      "destination": "https://yeollock.me/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/advertiser(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/contract(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/influencer(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/signup(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/marketing(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.supabase.co https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com https://*.ggpht.com https://*.googleusercontent.com https://*.cdninstagram.com https://*.fbcdn.net https://*.tiktokcdn.com https://*.pstatic.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://*.googletagmanager.com https://*.clarity.ms; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.env(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/data/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/server/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/supabase/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/tests/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/lib/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/qa-artifacts/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs/sales/(.*).csv",
      "destination": "/api/index"
    },
    {
      "source": "/docs/sales/(.*).tsv",
      "destination": "/api/index"
    },
    {
      "source": "/docs/sales/(.*).json",
      "destination": "/api/index"
    },
    {
      "source": "/package.json",
      "destination": "/api/index"
    },
    {
      "source": "/package-lock.json",
      "destination": "/api/index"
    },
    {
      "source": "/tsconfig(.*).json",
      "destination": "/api/index"
    },
    {
      "source": "/vite.config.ts",
      "destination": "/api/index"
    },
    {
      "source": "/AGENTS.md",
      "destination": "/api/index"
    },
    {
      "source": "/en/creators",
      "destination": "/en/creators/index.html"
    },
    {
      "source": "/ja/creators",
      "destination": "/ja/creators/index.html"
    },
    {
      "source": "/zh/creators",
      "destination": "/zh/creators/index.html"
    },
    {
      "source": "/intro/advertiser",
      "destination": "/intro/advertiser/index.html"
    },
    {
      "source": "/intro/influencer",
      "destination": "/intro/influencer/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/legal/e-sign-consent",
      "destination": "/legal/e-sign-consent/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/resources",
      "destination": "/resources/index.html"
    },
    {
      "source": "/resources/influencer-ad-contract",
      "destination": "/resources/influencer-ad-contract/index.html"
    },
    {
      "source": "/resources/ppl-contract-checklist",
      "destination": "/resources/ppl-contract-checklist/index.html"
    },
    {
      "source": "/resources/collaboration-contract",
      "destination": "/resources/collaboration-contract/index.html"
    },
    {
      "source": "/resources/group-buying-contract",
      "destination": "/resources/group-buying-contract/index.html"
    },
    {
      "source": "/resources/instagram-sponsorship-contract",
      "destination": "/resources/instagram-sponsorship-contract/index.html"
    },
    {
      "source": "/resources/youtube-ppl-contract",
      "destination": "/resources/youtube-ppl-contract/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
