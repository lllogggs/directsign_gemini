    "repair:influencer-quality": "node scripts/repair-influencer-data-quality.mjs",
    "curate:influencers": "node scripts/curate-influencer-marketplace.mjs",
    "directory:influencers:rebuild:dry": "node scripts/rebuild-public-influencer-directory.mjs",
    "directory:influencers:rebuild:apply": "node scripts/rebuild-public-influencer-directory.mjs --apply",
    "seed:qa-marketplace": "node scripts/seed-qa-marketplace-scenario.mjs",
    "seed:test-accounts": "node scripts/seed-test-accounts.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs"
