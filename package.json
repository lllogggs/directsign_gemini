    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "shadcn": "^4.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
