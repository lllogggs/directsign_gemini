# GEMINI_API_KEY:
# Optional/reserved for future server-side Gemini features. The current public
# launch path does not require it, and it must never be exposed with a VITE_
# prefix if enabled later.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, auth callbacks, and API endpoints.
# Set this explicitly in Vercel production.
APP_URL="https://yeollock.me"
VITE_PUBLIC_SITE_URL="https://yeollock.me"

# PRODUCT_NAME / VITE_PRODUCT_NAME:
# Display name used by server logs, HTML metadata, and client UI.
# Keep them aligned when frontend and API environments are managed separately.
PRODUCT_NAME="연락미"
VITE_PRODUCT_NAME="연락미"

# Public analytics IDs. These are client-visible by design.
# The app only loads analytics on yeollock.me/www.yeollock.me unless an override
# is enabled for verification.
VITE_GOOGLE_ANALYTICS_ID="G-PDTVNFRD1W"
VITE_MICROSOFT_CLARITY_ID="wx0bvf6bl5"
# Keep GA fail-closed until its property-side Enhanced Measurement setting for
# history-based page views has been verified as disabled.
VITE_GA_HISTORY_MEASUREMENT_VERIFIED="false"
VITE_ENABLE_LOCAL_ANALYTICS="false"
VITE_ENABLE_NON_PRODUCTION_ANALYTICS="false"

# GOOGLE_SITE_VERIFICATION / VITE_GOOGLE_SITE_VERIFICATION:
# Optional public Search Console ownership token. Set the value from Google
# Search Console before production build; the build writes it into the initial
# HTML <head> as <meta name="google-site-verification" content="...">.
GOOGLE_SITE_VERIFICATION=""
VITE_GOOGLE_SITE_VERIFICATION=""

# Google Workspace export/schedule integration:
# Used for Google Sheets dashboard exports now and Google Calendar schedule sync later.
# Configure one Google Cloud OAuth Web Client with these redirect URIs:
# - https://yeollock.me/api/google/oauth/callback
# - http://localhost:3000/api/google/oauth/callback
# Enable Google Sheets API, Google Drive API, and Google Calendar API in the same project.
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=""
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=""
GOOGLE_WORKSPACE_TOKEN_ENCRYPTION_SECRET=""

# NAVER_SITE_VERIFICATION / VITE_NAVER_SITE_VERIFICATION:
# Optional public Search Advisor ownership token. Set the value from Naver
# Search Advisor before production build; the build writes it into the initial
# HTML <head> as <meta name="naver-site-verification" content="...">.
NAVER_SITE_VERIFICATION=""
VITE_NAVER_SITE_VERIFICATION=""

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY:
# Optional. When both are set, the local API stores contracts in Supabase.
# Keep the service role key server-side only. Do not prefix it with VITE_.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_CONTRACTS_TABLE="directsign_contracts"
SUPABASE_SCHEMA_VERSION="v2"

# CRON_SECRET:
# Required when Vercel Cron calls server-side maintenance endpoints.
# Vercel sends Authorization: Bearer $CRON_SECRET to configured cron paths.
CRON_SECRET=""
DISCORD_OPERATIONS_WEBHOOK_URL=""
DISCORD_OPERATIONS_BOT_TOKEN=""
DISCORD_OPERATIONS_CHANNEL_ID=""
MARKETPLACE_FOLLOWER_SYNC_MAX_CHANNELS="25"
MARKETPLACE_FOLLOWER_SYNC_STALE_DAYS="6"
ENABLE_AUTOMATIC_MARKETPLACE_FOLLOWER_SYNC="false"

# USER_SESSION_FAST_PATH_SECRET / DIRECTSIGN_TOKEN_ENCRYPTION_SECRET:
# Generate strong values with: npm run secrets:generate
# Required for production operations. Keep server-side only. Do not prefix with VITE_.
# Local development may omit the fast-path secret; production must keep both stable.
USER_SESSION_FAST_PATH_SECRET=""
ADMIN_LOGIN_MAX_FAILURES="5"
ADMIN_LOGIN_WINDOW_SECONDS="900"
ADMIN_LOGIN_LOCK_SECONDS="900"
PUBLIC_AUTH_IP_MAX_ATTEMPTS="40"
PUBLIC_AUTH_EMAIL_MAX_ATTEMPTS="8"
PUBLIC_AUTH_WINDOW_SECONDS="900"
SENSITIVE_ENDPOINT_IP_MAX_ATTEMPTS="60"
SENSITIVE_ENDPOINT_SUBJECT_MAX_ATTEMPTS="20"
SENSITIVE_ENDPOINT_WINDOW_SECONDS="900"
DIRECTSIGN_TOKEN_ENCRYPTION_SECRET=""
AUTH_ALERT_WINDOW_MINUTES="10"
AUTH_ALERT_COOLDOWN_MINUTES="15"
AUTH_ALERT_PROVIDER_ERROR_THRESHOLD="5"
AUTH_ALERT_TERMINAL_THRESHOLD="20"
AUTH_ALERT_RATE_LIMIT_THRESHOLD="10"
CONTENT_SECURITY_POLICY_REPORT_ONLY="false"

# DIRECTSIGN_DEMO_MODE:
# Set to "true" only for demos. Real service mode keeps an empty DB empty.
DIRECTSIGN_DEMO_MODE="false"
DIRECTSIGN_ALLOW_PRODUCTION_DEMO_MODE="false"
YEOLLOCK_ALLOW_PRODUCTION_TEST_DATA="false"
DIRECTSIGN_DEFAULT_ADVERTISER_ID="adv_1"
DIRECTSIGN_DEFAULT_INFLUENCER_ID="influencer_guest"
DIRECTSIGN_ALLOW_LOCAL_PRIVATE_FILE_FALLBACK="false"

# SIGNED_PDF_FONT_PATH:
# Optional but recommended. Point to a TTF Korean font so signed contract PDFs
# can embed readable Korean text in server-generated evidence records.
SIGNED_PDF_FONT_PATH=""

# Public legal document operator information. These values are client-visible
# on privacy/terms pages. Keep "free_individual" while the service is free and
# not operated under a registered business. Keep only public-facing operator
# contact details here during early product validation.
# Switch to "registered_business" only before paid/business use.
VITE_LEGAL_OPERATING_MODE="free_individual"
VITE_LEGAL_OPERATOR_NAME=""
VITE_LEGAL_REPRESENTATIVE_NAME=""
VITE_LEGAL_BUSINESS_REGISTRATION_NUMBER=""
VITE_LEGAL_MAIL_ORDER_BUSINESS_NUMBER=""
VITE_LEGAL_ADDRESS=""
VITE_LEGAL_CONTACT_EMAIL="yeollockme@gmail.com"
VITE_LEGAL_CONTACT_PHONE=""

# Optional verification automation adapters. Leave blank until the external
# provider app/API registration is complete; the product falls back to manual
# review when these are missing.
NTS_BUSINESS_STATUS_API_KEY=""
NTS_BUSINESS_VALIDATE_API_KEY=""
# Emergency kill switch. Leave true for the three-field NTS instant-verification path.
VERIFICATION_AUTO_APPROVE_BUSINESS="true"
VERIFICATION_AUTO_APPROVE_PLATFORM="false"
# Enable only after the official account token, expiry, and signed Meta webhook are verified.
VERIFICATION_AUTO_APPROVE_INSTAGRAM_DM="false"
YOUTUBE_DATA_API_KEY=""
GOOGLE_OAUTH_CLIENT_ID=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# Shared KST-daily budget for all server-side Naver Search API requests.
# Defaults reserve at most 80% of the documented 25,000-request daily allowance.
NAVER_SEARCH_DAILY_LIMIT="25000"
NAVER_SEARCH_DAILY_BUDGET_RATIO="0.8"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCOUNT_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v24.0"
META_GRAPH_ACCESS_TOKEN=""
META_INSTAGRAM_ACCESS_TOKEN=""
# Required ISO-8601 expiry time; the operations sweep alerts seven days before expiry.
META_INSTAGRAM_ACCESS_TOKEN_EXPIRES_AT=""
META_IG_USER_ID=""
META_WEBHOOK_VERIFY_TOKEN=""
VITE_INSTAGRAM_OFFICIAL_HANDLE="yeollockme"
RESEND_API_KEY=""
VERIFICATION_EMAIL_FROM="연락미 <no-reply@auth.yeollock.me>"
